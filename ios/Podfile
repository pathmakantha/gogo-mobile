# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# react-native-permissions ships every permission type behind its own iOS
# subspec, opted into by rewriting RNPermissions.podspec's source_files at
# `pod install` time — without this, RNPermissions.mm compiles with zero
# handlers registered, and PermissionsScreen's request() calls fail at
# runtime with "No permission handler detected." Keep this list in sync
# with what PermissionsScreen.tsx actually requests.
require_relative '../node_modules/react-native-permissions/scripts/setup.rb'
setup_permissions([
  'LocationWhenInUse',
  'Notifications',
])

platform :ios, min_ios_version_supported
prepare_react_native_project!

# @react-native-firebase requires static frameworks: FirebaseAuth's generated
# `-Swift.h` interop header (which RNFBAuth's Objective-C++ wrapper imports)
# is only produced when Firebase builds as a framework, not a static library.
# use_modular_headers! alone is not sufficient. Overridable via USE_FRAMEWORKS.
linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

# Official react-native-firebase workaround for FirebaseAuth's Swift interop
# (see above). RNFBApp/RNFBAuth still trip Clang's strict
# -Wnon-modular-include-in-framework-module against RN 0.86's prebuilt
# React-Core headers even with this set — that's handled below via
# CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES in post_install.
$RNFirebaseAsStaticFramework = true

target 'GOGOmobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # RN 0.86's prebuilt React-Core doesn't publish a Clang module map, so any
    # pod built as a framework (RNFBApp, RNFBAuth, ...) that #imports its
    # headers (RCTBridgeModule.h etc.) fails -Werror,-Wnon-modular-include...
    # Demote it to a warning rather than reverting to non-framework linkage,
    # which FirebaseAuth's generated Swift header requires (see above).
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
  end
end
